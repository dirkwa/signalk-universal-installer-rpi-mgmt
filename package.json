{
  "name": "signalk-universal-installer-rpi-mgmt",
  "version": "0.1.0",
  "description": "RPI Manager: shows the computer's health and history, and restarts Signal K, reboots or powers off the computer, for Signal K Universal Installer setups",
  "author": "Dirk Wahrheit",
  "main": "plugin/index.js",
  "type": "module",
  "signalk-plugin-enabled-by-default": true,
  "scripts": {
    "format": "prettier --write . && eslint --fix .",
    "ci-lint": "eslint . && prettier --check .",
    "build": "vite build && vite build -c vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "build:all": "npm run ci-lint && npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "signalk-category-hardware",
    "raspberry-pi",
    "reboot",
    "shutdown"
  ],
  "signalk": {
    "displayName": "RPI Manager",
    "appIcon": "./icon.svg",
    "requires": [
      "signalk-rpi-stats"
    ],
    "screenshots": [
      "./docs/screenshots/rpi-manager.png",
      "./docs/screenshots/rpi-manager-phone.png"
    ],
    "recommends": [
      "signalk-updater"
    ]
  },
  "files": [
    "plugin/**/*",
    "public/**/*",
    "docs/screenshots/*.png"
  ],
  "engines": {
    "node": ">=22.15.0",
    "signalk": ">=2.31.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkwa/signalk-universal-installer-rpi-mgmt.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.35.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "uplot": "^1.6.32",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
